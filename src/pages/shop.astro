---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { looksByCategory, shopCategories } from '../data/shop';
import { whatsappConsult, whatsappBuy, withBase } from '../data/site';
---

<BaseLayout
  title="Shop D’TAILOR — Kaftans, agbadas and ready-to-wear"
  description="Buy D’TAILOR kaftans, agbadas, women’s wear and ready-to-wear looks directly via WhatsApp. Handmade in Accra, Ghana."
  image="/images/looks/agbada-ivory.jpg"
>
  <SiteHeader />

  <main id="main-content">
    <section class="page-intro" id="top">
      <div class="shell page-intro-split">
        <div>
          <p class="eyebrow"><span></span> Shop</p>
          <h1>The house.</h1>
        </div>
        <p>
          Choose a look, then message D’TAILOR on WhatsApp. Price and making are confirmed before work begins.
        </p>
      </div>
    </section>

    <nav class="shop-filters" aria-label="Shop categories">
      <div class="shell">
        {shopCategories.map((category) => (
          <a href={`#${category.id}`}>{category.title}</a>
        ))}
        <a href="#suits">Suits</a>
        <a class="shop-filters-buy" href={whatsappConsult} target="_blank" rel="noreferrer">WhatsApp</a>
      </div>
    </nav>

    {shopCategories.map((category) => (
      <section class="shop-category section" id={category.id}>
        <div class="shell">
          <div class="shop-heading">
            <h2>{category.title}</h2>
            <p>{category.intro}</p>
          </div>
          <div class="product-grid">
            {looksByCategory(category.id).map((look) => (
              <article class="product-card">
                <figure>
                  <img src={withBase(look.image)} alt={look.alt} width="1200" height="1600" loading="lazy" />
                </figure>
                <div class="product-meta">
                  <h3>{look.title}</h3>
                  <a href={look.buy} target="_blank" rel="noreferrer">Enquire</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))}

    <section class="shop-category section section-dark" id="suits">
      <div class="shell suits-enquiry">
        <p class="eyebrow light"><span></span> Made to measure</p>
        <h2>Suits.</h2>
        <p>Suits and political suits are made to your measurements. Message D’TAILOR with the occasion.</p>
        <a class="text-link light" href={whatsappBuy('a suit or political suit')} target="_blank" rel="noreferrer">
          Request a suit
        </a>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
