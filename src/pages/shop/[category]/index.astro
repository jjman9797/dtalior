---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import ShopFilters from '../../../components/ShopFilters.astro';
import ProductCard from '../../../components/ProductCard.astro';
import OrderPanel from '../../../components/OrderPanel.astro';
import { categoryById, looksByCategory, shopCategories } from '../../../data/shop';
import { withBase } from '../../../data/site';

export function getStaticPaths() {
  return shopCategories.map((category) => ({
    params: { category: category.id },
  }));
}

const { category: categoryId } = Astro.params;
const category = categoryById(categoryId ?? '');
if (!category) {
  throw new Error(`Unknown shop category: ${categoryId}`);
}

const looks = looksByCategory(category.id);
const hasLooks = looks.length > 0;
const orderNote = hasLooks
  ? 'Photographs on this page are examples. Request a look as seen, or buy this making without matching a photograph. Made to order. Price is confirmed on WhatsApp before work begins.'
  : 'This making is buyable made to order. No photograph is on the site yet. Choose a size and buy on WhatsApp, or enquire first. Price is confirmed before work begins.';
---

<BaseLayout
  title={`${category.title} · Store · D’TAILOR`}
  description={category.intro}
>
  <SiteHeader />

  <main id="main-content">
    <section class="page-intro" id="top">
      <div class="shell page-intro-split">
        <div>
          <p class="label"><span class="dept-no">{category.eyebrow}</span> Store</p>
          <h1>{category.title}.</h1>
        </div>
        <p>
          {category.intro}
          {hasLooks
            ? ' Select a colour, sleeve and size on a photographed look, or buy this making made to order below.'
            : ' Choose a size and buy on WhatsApp, or enquire first.'}
        </p>
      </div>
    </section>

    {hasLooks ? (
      <section class="catalog section">
        <div class="shell store-layout">
          <ShopFilters />
          <div class="store-results">
            <p class="result-count" data-filter-count>Showing {looks.length} of {looks.length}</p>
            <div class="product-grid" data-product-grid>
              {looks.map((look) => (
                <ProductCard look={look} />
              ))}
            </div>
            <div class="filter-empty" data-filter-empty hidden>
              <p>No looks match those filters.</p>
              <button class="clear-all" type="button" data-clear-empty>Clear all</button>
            </div>
          </div>
        </div>
      </section>
    ) : null}

    <section class="section">
      <div class="shell">
        <OrderPanel item={category.title} note={orderNote} />
      </div>
    </section>

    {(category.enquiryCards?.length || category.related?.length) ? (
      <section class="section">
        <div class="shell">
          {category.enquiryCards?.length ? (
            <>
              <p class="label">Also in this department</p>
              <div class="enquiry-grid">
                {category.enquiryCards.map((card) => (
                  <a class="enquiry-card" href={withBase(card.href)}>
                    <h2>{card.title}</h2>
                    <p>{card.text}</p>
                    <span class="text-link">Buy</span>
                  </a>
                ))}
              </div>
            </>
          ) : null}
          {category.related?.length ? (
            <>
              <p class="label related-label">Related</p>
              <div class="enquiry-grid">
                {category.related.map((card) => (
                  <a class="enquiry-card" href={withBase(card.href)}>
                    <h2>{card.title}</h2>
                    <p>{card.text}</p>
                    <span class="text-link">Open</span>
                  </a>
                ))}
              </div>
            </>
          ) : null}
        </div>
      </section>
    ) : null}
  </main>

  <SiteFooter />
</BaseLayout>
