---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LookImage from '../components/LookImage.astro';
import { aboutClose, aboutFoot, aboutLead, aboutSections } from '../data/about';
import {
  email,
  facebook,
  founderName,
  instagram,
  phoneDisplay,
  phoneHref,
  statement,
  tagline,
  withBase,
} from '../data/site';
---

<BaseLayout
  title={`About D’TAILOR · ${founderName}`}
  description="D’TAILOR is an African fashion and tailoring brand based in Accra, Ghana. Founded by Nigerian entrepreneur Abdullahi Idowu Olaiya. Bespoke, ready-to-wear and styling."
>
  <SiteHeader />

  <main id="main-content">
    <section class="about-hero" id="top">
      <div class="shell about-grid">
        <figure>
          <LookImage
            src="/images/looks/founder-purple.jpg"
            alt={`${founderName}, founder of D’TAILOR, wearing a purple embroidered kaftan`}
            objectPosition="50% 12%"
            width={1600}
            height={2200}
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>{founderName}, Accra</figcaption>
        </figure>
        <div class="about-copy">
          <p class="label">Founder and creative director</p>
          <h1>{founderName}</h1>
          <p>Nigerian entrepreneur. Brand based in Accra, Ghana.</p>
          {aboutLead.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
    </section>

    <section class="about-chapters section">
      <div class="shell">
        {aboutSections.map((chapter) => (
          <article class="about-chapter" id={chapter.id}>
            <div>
              <p class="label">The house</p>
              <h2>{chapter.title}</h2>
            </div>
            <div class="about-copy">
              {chapter.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="about-close">
      <div class="shell">
        <p class="close-line">{aboutClose}</p>
        <p class="about-foot">{aboutFoot}</p>
        <blockquote>{tagline}</blockquote>
        <p>{statement}</p>
        <div class="hero-actions">
          <a class="button" href={withBase('book')}>Book a fitting</a>
          <a class="text-link" href={withBase('shop')}>Shop the store</a>
        </div>
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="shell contact-inner">
        <div class="contact-copy">
          <p class="label">Visit</p>
          <h2>Ecobank Spintex Road,<br />Accra.</h2>
          <p>Call, write, or message the house. Worldwide via WhatsApp.</p>
          <a class="button" href={withBase('book')}>Book a fitting</a>
        </div>
        <address class="contact-details">
          <div>
            <span class="label">Call</span>
            <a href={phoneHref}>{phoneDisplay}</a>
          </div>
          <div>
            <span class="label">Email</span>
            <a href={`mailto:${email}`}>{email}</a>
          </div>
          <div>
            <span class="label">Follow</span>
            <p>
              <a href={instagram} target="_blank" rel="noreferrer">Instagram</a>
              <a href={facebook} target="_blank" rel="noreferrer">Facebook</a>
            </p>
          </div>
        </address>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
