---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { email, facebook, instagram, phoneDisplay, phoneHref, whatsappConsult, withBase } from '../data/site';
---

<BaseLayout
  title="About D’TAILOR — Founder and unique collaboration"
  description="Meet the founder of D’TAILOR, an Accra clothing brand built around unique collaboration, craftsmanship and modern African elegance."
  image="/images/looks/founder-purple.jpg"
>
  <SiteHeader />

  <main id="main-content">
    <section class="about-hero" id="top">
      <div class="shell about-grid">
        <figure>
          <img
            src={withBase('images/looks/founder-purple.jpg')}
            alt="Founder of D’TAILOR wearing a purple embroidered kaftan"
            width="1600"
            height="2200"
          />
          <figcaption>Founder, Accra</figcaption>
        </figure>
        <div class="about-copy">
          <p class="eyebrow"><span></span> About</p>
          <h1>The founder.</h1>
          <p>
            D’TAILOR is led by its founder—pictured here in a purple embroidered kaftan from the house.
          </p>
          <p>
            The brand is built around unique collaboration. Each client’s personality, lifestyle, profession and occasion come first. Those ideas are then joined with D’TAILOR’s craftsmanship, fabric and colour.
          </p>
          <blockquote>
            “Your personality, our craftsmanship — one unique creation.”
          </blockquote>
          <div class="hero-actions">
            <a class="text-link" href={whatsappConsult} target="_blank" rel="noreferrer">Start a consultation</a>
            <a class="text-link" href={withBase('shop')}>Shop the looks</a>
          </div>
        </div>
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="shell contact-inner">
        <div class="contact-copy">
          <p class="eyebrow light"><span></span> The house</p>
          <h2>An African fashion house.</h2>
          <p>
            D’TAILOR is growing toward a respected house known for craftsmanship, distinctive design and modern African elegance—serving clients in Accra and internationally.
          </p>
        </div>
        <address class="contact-details">
          <div>
            <span>Call</span>
            <a href={phoneHref}>{phoneDisplay}</a>
          </div>
          <div>
            <span>Email</span>
            <a href={`mailto:${email}`}>{email}</a>
          </div>
          <div>
            <span>Follow</span>
            <p>
              <a href={instagram} target="_blank" rel="noreferrer">Instagram</a>
              <a href={facebook} target="_blank" rel="noreferrer">Facebook</a>
            </p>
          </div>
        </address>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
