---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Logo from '../components/Logo.astro';
import LookImage from '../components/LookImage.astro';
import { absoluteUrl, facebook, founderName, instagram, ogImagePath, statement, tagline, whatsappConsult as whatsapp, withBase } from '../data/site';
import { featuredCategories } from '../data/shop';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ClothingStore',
  name: 'D’TAILOR',
  description: 'African high fashion and bespoke tailoring in Accra, Ghana.',
  url: absoluteUrl(),
  image: absoluteUrl(ogImagePath),
  logo: absoluteUrl(ogImagePath),
  telephone: '+233595665083',
  email: 'olaiyaidowu45@gmail.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Ecobank Spintex Road',
    addressLocality: 'Accra',
    addressCountry: 'GH',
  },
  sameAs: [facebook, instagram],
};
---

<BaseLayout
  title="D’TAILOR · African high fashion, Accra"
  description="D’TAILOR is an African high fashion house in Accra. Nigerian craftsmanship, Ghanaian atelier, kaftans, agbadas, suits and ready-to-wear, all made to order. Shop by size, colour and sleeve."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <SiteHeader />

  <main id="main-content">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-copy">
        <Logo variant="lockup" tagline />
        <p class="label hero-tag">{tagline}</p>
        <h1 id="hero-title">{statement}</h1>
        <p class="hero-intro">
          A Nigerian house, operating in Accra. Kaftans, agbadas, suits and ready-to-wear, made to order through unique collaboration.
        </p>
        <div class="hero-actions">
          <a class="button" href={withBase('shop')}>Enter the store</a>
          <a class="text-link" href={withBase('collection')}>View the collection</a>
        </div>
      </div>
      <figure class="hero-photo">
        <LookImage
          src="/images/looks/kaftan-brown-walk.jpg"
          alt="Man walking in a brown pinstripe kaftan set with gold shoulder detail and staff"
          objectPosition="50% 14%"
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 900px) 640px, 100vw"
          width={640}
          height={880}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </section>

    <section class="story section">
      <div class="shell story-grid">
        <div>
          <p class="label">The house</p>
          <h2>African. Precisely made.</h2>
        </div>
        <div class="story-copy">
          <p>
            {founderName} is Nigerian. The atelier and a newly opened storefront stand on Ecobank Spintex Road, Accra.
          </p>
          <p>
            Choose a making and buy it on WhatsApp. Everything is made to order. Photographed looks can be requested as seen.
          </p>
        </div>
      </div>
    </section>

    <section class="departments section" id="shop">
      <div class="shell">
        <div class="section-line">
          <p class="label">Shop by department</p>
          <a class="text-link" href={withBase('shop')}>All departments</a>
        </div>
        <div class="home-departments">
          {featuredCategories.map((category) =>
            category.image ? (
              <a class="department-door" href={withBase(`shop/${category.id}`)}>
                <LookImage src={category.image} alt={`${category.title} from D’TAILOR`} width={800} height={1000} />
                <span class="dept-no">{category.eyebrow}</span>
                <span class="dept-name">{category.navTitle ?? category.title}</span>
              </a>
            ) : null
          )}
        </div>
      </div>
    </section>

    <section class="atelier section">
      <div class="shell atelier-grid">
        <figure>
          <LookImage
            src="/images/looks/atelier-sky.jpg"
            alt="Sky kaftan and navy panel displayed inside the D’TAILOR Accra atelier"
            objectPosition="50% 18%"
            width={1600}
            height={2000}
          />
        </figure>
        <div>
          <p class="label">Accra</p>
          <h2>A storefront, now open.</h2>
          <p>
            The house has opened its storefront in Accra. Cloth, forms and finished looks live in the same room. A place to see the work, take measurements, and begin a commission.
          </p>
          <p>Ecobank Spintex Road. Message D’TAILOR before you visit, or buy from anywhere via WhatsApp. Every making is made to order.</p>
          <a class="text-link" href={withBase('about')}>Read the story</a>
        </div>
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="shell contact-inner">
        <div class="contact-copy">
          <p class="label">Enquire</p>
          <h2>Begin with a look, or with a conversation.</h2>
          <p>Tell us who you are dressing for, the size you need, and how you want to be seen.</p>
          <a class="button" href={whatsapp} target="_blank" rel="noreferrer">Message the house</a>
        </div>
        <address class="contact-details">
          <div>
            <span class="label">Visit</span>
            <p>Ecobank Spintex Road<br />Accra, Ghana</p>
          </div>
          <div>
            <span class="label">Call</span>
            <a href="tel:+233595665083">+233 59 566 5083</a>
          </div>
          <div>
            <span class="label">Email</span>
            <a href="mailto:olaiyaidowu45@gmail.com">olaiyaidowu45@gmail.com</a>
          </div>
          <div>
            <span class="label">Follow</span>
            <p>
              <a href={instagram} target="_blank" rel="noreferrer">Instagram</a>
              <a href={facebook} target="_blank" rel="noreferrer">Facebook</a>
            </p>
          </div>
        </address>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
