---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { facebook, instagram, whatsappConsult as whatsapp, withBase } from '../data/site';
import { shopLooks } from '../data/shop';

const featuredLooks = shopLooks.filter((look) =>
  ['founder-kaftan', 'agbada-ivory', 'kaftan-brown', 'womens-white', 'agbada-emerald', 'kaftan-blue'].includes(look.id)
);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ClothingStore',
  name: 'D’TAILOR',
  description: 'Modern African fashion, bespoke tailoring and personal styling in Accra, Ghana.',
  telephone: '+233595665083',
  email: 'olaiyaidowu45@gmail.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Ecobank Spintex Road',
    addressLocality: 'Accra',
    addressCountry: 'GH',
  },
  areaServed: 'Worldwide',
  sameAs: [facebook, instagram],
};
---

<BaseLayout
  title="D’TAILOR — Modern African Bespoke Tailoring"
  description="D’TAILOR creates bespoke African wear, suits and complete personal styling through one unique collaboration. Based in Accra, Ghana."
  image="/images/looks/agbada-ivory.jpg"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

  <SiteHeader overlay />

  <main id="main-content">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <img
        class="hero-image"
        src={withBase('images/looks/agbada-ivory.jpg')}
        alt="Ivory and gold agbada with coral beads, red cap and staff"
        width="1600"
        height="2200"
        fetchpriority="high"
      />
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="shell hero-inner">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow light">Accra · Ghana</p>
          <h1 id="hero-title">D’TAILOR</h1>
          <p class="hero-intro">Your personality, our craftsmanship — one unique creation.</p>
          <div class="hero-actions">
            <a class="text-link light" href={withBase('shop')}>Shop the house</a>
            <a class="text-link light" href={whatsapp} target="_blank" rel="noreferrer">Begin a consultation</a>
          </div>
        </div>
      </div>
    </section>

    <section class="looks section" id="collection">
      <div class="shell">
        <div class="section-line" data-reveal>
          <p class="eyebrow"><span></span> The collection</p>
          <a class="text-link" href={withBase('shop')}>View all looks</a>
        </div>
        <div class="look-grid">
          {featuredLooks.map((look) => (
            <a class="look-card" href={withBase('shop')} data-reveal>
              <img src={withBase(look.image)} alt={look.alt} width="900" height="1200" loading="lazy" />
              <span>{look.title}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="house section" id="story">
      <div class="shell house-grid">
        <figure data-reveal>
          <img
            src={withBase('images/looks/founder-purple.jpg')}
            alt="Founder of D’TAILOR wearing a purple embroidered kaftan"
            width="1600"
            height="2200"
            loading="lazy"
          />
        </figure>
        <div class="house-copy" data-reveal>
          <p class="eyebrow"><span></span> The house</p>
          <h2>Unique collaboration.</h2>
          <p>
            D’TAILOR is a close partnership between client and tailor. Your personality, lifestyle and occasion come first. Then craftsmanship, cloth and colour complete the look.
          </p>
          <p>Kaftans. Agbadas. Suits. Ready to wear. Made in Accra, worn with presence.</p>
          <a class="text-link" href={withBase('about')}>Meet the founder</a>
        </div>
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="shell contact-inner">
        <div class="contact-copy" data-reveal>
          <p class="eyebrow light"><span></span> Enquire</p>
          <h2>Let’s begin.</h2>
          <p>Tell us who you are dressing for, and how you want to be seen.</p>
          <a class="text-link light" href={whatsapp} target="_blank" rel="noreferrer">Message on WhatsApp</a>
        </div>
        <address class="contact-details" data-reveal>
          <div>
            <span>Visit</span>
            <p>Ecobank Spintex Road<br />Accra, Ghana</p>
          </div>
          <div>
            <span>Call</span>
            <a href="tel:+233595665083">+233 59 566 5083</a>
          </div>
          <div>
            <span>Email</span>
            <a href="mailto:olaiyaidowu45@gmail.com">olaiyaidowu45@gmail.com</a>
          </div>
          <div>
            <span>Follow</span>
            <p>
              <a href={instagram} target="_blank" rel="noreferrer">Instagram</a>
              <a href={facebook} target="_blank" rel="noreferrer">Facebook</a>
            </p>
          </div>
        </address>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
