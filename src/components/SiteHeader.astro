---
import { whatsappConsult, withBase } from '../data/site';

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const onShop = path.endsWith('/shop');
const onAbout = path.endsWith('/about');
---

<header class:list={['site-header', overlay ? 'is-overlay' : 'is-solid']} data-header>
  <nav class="nav shell" aria-label="Primary navigation">
    <a class="wordmark" href={withBase()} aria-label="D’TAILOR home">
      <span>D’TAILOR</span>
      <small>Accra</small>
    </a>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="nav-links" data-menu-button>
      <span>Menu</span>
      <i aria-hidden="true"></i>
    </button>

    <div class="nav-links" id="nav-links" data-nav-links>
      <a href={withBase('shop')} aria-current={onShop ? 'page' : undefined}>Shop</a>
      <a href={withBase('about')} aria-current={onAbout ? 'page' : undefined}>About</a>
      <a href={withBase('#contact')}>Contact</a>
    </div>

    <a class="nav-cta" href={whatsappConsult} target="_blank" rel="noreferrer">
      {onShop ? 'Enquire' : 'Consult'}
    </a>
  </nav>
</header>
