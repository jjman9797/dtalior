---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { withBase } from '../data/site';

interface Props {
  src: string;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  objectPosition?: string;
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  class: className,
  widths = [480, 800, 1200, 1600],
  sizes = '(min-width: 2400px) 20vw, (min-width: 900px) 30vw, 100vw',
  loading = 'lazy',
  fetchpriority = 'auto',
  objectPosition = '50% 14%',
  width,
  height,
} = Astro.props;

const modules = import.meta.glob<{ default: ImageMetadata }>('../assets/**/*.{jpg,jpeg}', { eager: true });
const asset = modules[`../assets${src}`]?.default;
const style = `object-position: ${objectPosition}`;
---

{
  asset ? (
    <Image
      src={asset}
      alt={alt}
      widths={widths}
      sizes={sizes}
      width={width}
      height={height}
      class={className}
      loading={loading}
      fetchpriority={fetchpriority}
      quality={70}
      style={style}
    />
  ) : (
    <img src={withBase(src)} alt={alt} class={className} loading={loading} fetchpriority={fetchpriority} style={style} width={width} height={height} />
  )
}
