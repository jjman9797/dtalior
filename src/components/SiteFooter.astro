---
import { facebook, instagram, withBase } from '../data/site';
---

<footer class="footer">
  <div class="shell footer-main">
    <a class="footer-brand" href={withBase()}>D’TAILOR</a>
    <p>An African fashion house.<br />Made personal, in Accra.</p>
    <nav aria-label="Footer navigation">
      <a href={withBase('shop')}>Shop</a>
      <a href={withBase('about')}>About</a>
      <a href={withBase('#contact')}>Contact</a>
      <a href={instagram} target="_blank" rel="noreferrer">Instagram</a>
      <a href={facebook} target="_blank" rel="noreferrer">Facebook</a>
    </nav>
  </div>
  <div class="shell footer-bottom">
    <p>© {new Date().getFullYear()} D’TAILOR</p>
    <p>Designed for your fit and comfort.</p>
    <a href="#top">Top</a>
  </div>
</footer>
